{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@notify-ui/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "../shared/src", "../home/src", "../sdk-guide/src",
    "../login/src", "../events/src", "../templates/src", "../memory/src",
    "../domain/src", "../vocab-rules/src", "../settings/src", "../dead-letters/src"]
}
